# Application Server Host & Port
PORT=5000
NODE_ENV=development

# PostgreSQL Database Connection
# format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://privacyshield_user:secure_db_pass_9988@postgres_db:5432/privacyshield_db?schema=public

# JSON Web Tokens Secrets (harden these values in production!)
JWT_ACCESS_SECRET=access_token_super_secret_key_12345
JWT_REFRESH_SECRET=refresh_token_super_secret_key_67890

# Security Cors & Limits Configuration
CORS_ORIGIN=*
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000
